{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "HuminLoop: Kill all processes",
      "type": "shell",
      "command": "npm run kill",
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "dedicated",
        "clear": true
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "detail": "Stop every HuminLoop electron / MCP / launcher process before a rebuild."
    },
    {
      "label": "HuminLoop: Kill all (force)",
      "type": "shell",
      "command": "npm run kill:force",
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "dedicated",
        "clear": true
      },
      "detail": "Same as Kill all but skips SIGTERM and goes straight to SIGKILL."
    },
    {
      "label": "HuminLoop: Dev (with DevTools)",
      "type": "shell",
      "command": "npm run dev",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "dedicated",
        "clear": true
      },
      "detail": "Launch HuminLoop with DevTools auto-open (HUMINLOOP_DEV=1)."
    },
    {
      "label": "HuminLoop: Start",
      "type": "shell",
      "command": "npm start",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "dedicated",
        "clear": true
      },
      "detail": "Launch HuminLoop normally."
    },
    {
      "label": "HuminLoop: Kill, then Dev",
      "dependsOrder": "sequence",
      "dependsOn": [
        "HuminLoop: Kill all processes",
        "HuminLoop: Dev (with DevTools)"
      ],
      "problemMatcher": [],
      "detail": "Clean restart: stop all instances, then launch with DevTools."
    },
    {
      "label": "HuminLoop: Build installer (choose OS)",
      "type": "shell",
      "command": "bash scripts/build.sh ${input:buildTarget}",
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "dedicated",
        "clear": true
      },
      "group": "build",
      "detail": "Build the latest HuminLoop installer with electron-builder. Prompts for target OS (Auto/Linux/Windows/macOS). Notes live in Postgres and are untouched."
    }
  ],
  "inputs": [
    {
      "id": "buildTarget",
      "type": "pickString",
      "description": "Build HuminLoop installer for which OS?",
      "options": [
        { "label": "Auto — detect this machine's OS", "value": "auto" },
        { "label": "Linux — AppImage + .deb", "value": "linux" },
        { "label": "Windows — NSIS .exe (needs Windows or Wine)", "value": "win" },
        { "label": "macOS — .dmg (needs macOS)", "value": "mac" }
      ],
      "default": "auto"
    }
  ]
}
